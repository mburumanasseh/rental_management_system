# =============================================================================
# Rental Management System – Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
# Optional: global API prefix e.g. "api"
API_PREFIX=
# Comma-separated allowed origins in production, e.g. https://app.example.com
CORS_ORIGIN=

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rental_db
# WARNING: set true only for local/dev. Always false in production.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT – MUST be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-very-long-and-secure-secret-key-32chars-min
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-very-long-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Encryption key for sensitive fields (exactly 32 bytes)
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=

# M-Pesa Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# Must be HTTPS and publicly reachable
MPESA_CALLBACK_URL=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# Notifications – Africa's Talking (SMS)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox

# Notifications – Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
