# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rental_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT – MUST be at least 32 characters. Change these in production!
JWT_SECRET=change-this-to-a-very-long-and-secure-secret-key-32chars-min
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-very-long-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Encryption (exactly 32 bytes for AES-256)
ENCRYPTION_KEY=

# M-Pesa Daraja (leave empty until Phase 3)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
